{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [],
    "module": "ES2022",
    "moduleResolution": "bundler",
    "rootDir": ".",
    "outDir": "dist/webview",
    "noImplicitReturns": false
  },
  "include": [
    "media/**/*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
