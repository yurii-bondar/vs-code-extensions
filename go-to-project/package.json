{
  "name": "go-to-project",
  "displayName": "Go To Project",
  "description": "Switch between open project windows with quick search, open recent projects or the projects in a directory, and jump back to the last project.",
  "version": "0.2.0",
  "publisher": "bondevn",
  "license": "MIT",
  "author": "Yurii Bondar",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#3A6FD8",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yurii-bondar/vs-code-extensions.git",
    "directory": "go-to-project"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Keymaps",
    "Other"
  ],
  "keywords": [
    "project",
    "projects",
    "project switcher",
    "switch window",
    "window switcher",
    "recent projects",
    "open recent",
    "workspace",
    "jetbrains",
    "git branch"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "npm run build && node --test dist/test/*.test.js",
    "package": "npx @vscode/vsce package",
    "vscode:prepublish": "npm run build"
  },
  "main": "./dist/extension.js",
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "goToProject.open",
        "title": "Go To Project"
      },
      {
        "command": "goToProject.recent",
        "title": "Go To Recent Project"
      },
      {
        "command": "goToProject.last",
        "title": "Go To Last Project"
      },
      {
        "command": "goToProject.currentDirectory",
        "title": "Go To Project in This Directory"
      },
      {
        "command": "goToProject.addDirectory",
        "title": "Go To Project: Add Directory…"
      },
      {
        "command": "goToProject.directory1",
        "title": "Go To Project in Directory 1"
      },
      {
        "command": "goToProject.directory2",
        "title": "Go To Project in Directory 2"
      },
      {
        "command": "goToProject.directory3",
        "title": "Go To Project in Directory 3"
      },
      {
        "command": "goToProject.directory4",
        "title": "Go To Project in Directory 4"
      },
      {
        "command": "goToProject.directory5",
        "title": "Go To Project in Directory 5"
      },
      {
        "command": "goToProject.directory6",
        "title": "Go To Project in Directory 6"
      },
      {
        "command": "goToProject.directory7",
        "title": "Go To Project in Directory 7"
      },
      {
        "command": "goToProject.directory8",
        "title": "Go To Project in Directory 8"
      },
      {
        "command": "goToProject.directory9",
        "title": "Go To Project in Directory 9"
      }
    ],
    "keybindings": [
      {
        "command": "goToProject.open",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p"
      },
      {
        "command": "goToProject.recent",
        "key": "ctrl+alt+e",
        "mac": "cmd+alt+e"
      },
      {
        "command": "goToProject.currentDirectory",
        "key": "ctrl+alt+r",
        "mac": "cmd+r"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "goToProject.last",
          "when": "goToProject.hasLast"
        },
        {
          "command": "goToProject.directory1",
          "when": "goToProject.directoryCount >= 1"
        },
        {
          "command": "goToProject.directory2",
          "when": "goToProject.directoryCount >= 2"
        },
        {
          "command": "goToProject.directory3",
          "when": "goToProject.directoryCount >= 3"
        },
        {
          "command": "goToProject.directory4",
          "when": "goToProject.directoryCount >= 4"
        },
        {
          "command": "goToProject.directory5",
          "when": "goToProject.directoryCount >= 5"
        },
        {
          "command": "goToProject.directory6",
          "when": "goToProject.directoryCount >= 6"
        },
        {
          "command": "goToProject.directory7",
          "when": "goToProject.directoryCount >= 7"
        },
        {
          "command": "goToProject.directory8",
          "when": "goToProject.directoryCount >= 8"
        },
        {
          "command": "goToProject.directory9",
          "when": "goToProject.directoryCount >= 9"
        }
      ]
    },
    "configuration": {
      "title": "Go To Project",
      "properties": {
        "goToProject.includeRecent": {
          "type": "boolean",
          "default": true,
          "description": "Show a \"Recent projects…\" entry at the end of the Go To Project list."
        },
        "goToProject.showBranch": {
          "type": "boolean",
          "default": true,
          "description": "Show the current git branch next to each local project."
        },
        "goToProject.directories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "application",
          "markdownDescription": "Folders whose projects you want one key away, besides the one this window's project is in. Entry *n* opens with **Go To Project in Directory n**; `~` is your home folder. **Go To Project: Add Directory…** adds one and opens Keyboard Shortcuts at its command."
        }
      }
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@types/vscode": "~1.85.0",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
