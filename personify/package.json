{
  "name": "personify",
  "displayName": "Personify",
  "description": "One friendly panel to customize hotkeys, sidebar/editor/terminal colors and fonts, and JS/TS/Go syntax colors.",
  "icon": "media/icon.png",
  "version": "0.1.0",
  "publisher": "bondevn",
  "license": "MIT",
  "author": "Yurii Bondar",
  "repository": {
    "type": "git",
    "url": "https://github.com/yurii-bondar/vs-code-extensions.git",
    "directory": "personify"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Themes",
    "Keymaps",
    "Other"
  ],
  "keywords": [
    "theme",
    "colors",
    "keybindings",
    "syntax",
    "customize",
    "personalize",
    "hotkeys",
    "fonts",
    "terminal",
    "sidebar",
    "typescript",
    "go",
    "color theme"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.webview.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.webview.json",
    "lint": "eslint .",
    "test": "npm run build && node --test dist/test/*.test.js",
    "package": "npx @vscode/vsce package",
    "vscode:prepublish": "npm run build"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "personify.open",
        "title": "Open",
        "category": "Personify"
      },
      {
        "command": "personify.openHotkeys",
        "title": "Hotkeys",
        "category": "Personify"
      },
      {
        "command": "personify.openAppearance",
        "title": "Appearance (Sidebar, Editor, Terminal)",
        "category": "Personify"
      },
      {
        "command": "personify.openSyntax",
        "title": "Syntax Colors",
        "category": "Personify"
      }
    ],
    "configuration": {
      "title": "Personify",
      "properties": {
        "personify.showStatusBarItem": {
          "type": "boolean",
          "default": true,
          "description": "Show the Personify button in the status bar."
        },
        "personify.keybindingsPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to keybindings.json. Leave empty to detect it (set this when you use a non-default VS Code profile)."
        }
      }
    }
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@types/vscode": "~1.85.0",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
