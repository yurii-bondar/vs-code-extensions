{
  "name": "claude-ctx-man",
  "displayName": "Claude Ctx Man",
  "description": "Several Claude Code accounts in one place: switch with one click, move a session to another account and keep going, or hand it off to Cursor and other tools.",
  "icon": "media/icon.png",
  "version": "0.2.0",
  "publisher": "bondevn",
  "license": "MIT",
  "author": "Yurii Bondar",
  "repository": {
    "type": "git",
    "url": "https://github.com/yurii-bondar/vs-code-extensions.git",
    "directory": "claude-ctx-man"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "AI"
  ],
  "keywords": [
    "claude",
    "claude code",
    "anthropic",
    "accounts",
    "switch account",
    "session",
    "resume",
    "handoff",
    "cursor",
    "status line"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.webview.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.webview.json",
    "lint": "eslint .",
    "test": "npm run build && node --test dist/test/*.test.js",
    "package": "npx @vscode/vsce package",
    "vscode:prepublish": "npm run build"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ctxMan",
          "title": "Claude Accounts",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "ctxMan": [
        {
          "id": "ctxMan.sessions",
          "name": "Accounts",
          "type": "webview"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "ctxMan.sessions",
        "contents": "No Claude Code accounts found yet.\nEach account is a config folder such as ~/.claude or ~/.claude-work. Log in to Claude Code once, or point to an existing folder.\n[Add Account Folder](command:ctxMan.addAccount)"
      }
    ],
    "commands": [
      {
        "command": "ctxMan.switchAccount",
        "title": "Switch Account",
        "category": "Claude Ctx Man",
        "icon": "$(account)"
      },
      {
        "command": "ctxMan.activateAccount",
        "title": "Use This Account",
        "category": "Claude Ctx Man",
        "icon": "$(check)"
      },
      {
        "command": "ctxMan.openTerminal",
        "title": "New Claude Session",
        "category": "Claude Ctx Man",
        "icon": "$(add)"
      },
      {
        "command": "ctxMan.resumeHere",
        "title": "Resume",
        "category": "Claude Ctx Man",
        "icon": "$(play)"
      },
      {
        "command": "ctxMan.continueOnAccount",
        "title": "Continue on Another Account",
        "category": "Claude Ctx Man",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "ctxMan.exportHandoff",
        "title": "Hand Off to Cursor / Other Tool",
        "category": "Claude Ctx Man",
        "icon": "$(export)"
      },
      {
        "command": "ctxMan.copySessionId",
        "title": "Copy Session ID",
        "category": "Claude Ctx Man"
      },
      {
        "command": "ctxMan.revealSession",
        "title": "Reveal Transcript File",
        "category": "Claude Ctx Man"
      },
      {
        "command": "ctxMan.addAccount",
        "title": "Add Account Folder…",
        "category": "Claude Ctx Man",
        "icon": "$(add)"
      },
      {
        "command": "ctxMan.hideAccount",
        "title": "Hide Account",
        "category": "Claude Ctx Man",
        "icon": "$(eye-closed)"
      },
      {
        "command": "ctxMan.showHiddenAccounts",
        "title": "Show Hidden Accounts…",
        "category": "Claude Ctx Man",
        "icon": "$(eye)"
      },
      {
        "command": "ctxMan.configureStatusLine",
        "title": "Customize Claude Status Line…",
        "category": "Claude Ctx Man",
        "icon": "$(pulse)"
      },
      {
        "command": "ctxMan.refresh",
        "title": "Refresh",
        "category": "Claude Ctx Man",
        "icon": "$(refresh)"
      },
      {
        "command": "ctxMan.toggleAllProjects",
        "title": "Toggle: This Workspace / All Projects",
        "category": "Claude Ctx Man",
        "icon": "$(list-tree)"
      },
      {
        "command": "ctxMan.showAllProjects",
        "title": "Show Sessions from All Projects",
        "category": "Claude Ctx Man",
        "icon": "$(list-tree)"
      },
      {
        "command": "ctxMan.showWorkspaceOnly",
        "title": "Show Only This Workspace",
        "category": "Claude Ctx Man",
        "icon": "$(list-flat)"
      },
      {
        "command": "ctxMan.setupAiFiles",
        "title": "Set Up AI Config Files…",
        "category": "Claude Ctx Man",
        "icon": "$(wand)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ctxMan.switchAccount",
          "when": "view == ctxMan.sessions",
          "group": "navigation@1"
        },
        {
          "command": "ctxMan.showAllProjects",
          "when": "view == ctxMan.sessions && !ctxMan.allProjects",
          "group": "navigation@2"
        },
        {
          "command": "ctxMan.showWorkspaceOnly",
          "when": "view == ctxMan.sessions && ctxMan.allProjects",
          "group": "navigation@2"
        },
        {
          "command": "ctxMan.refresh",
          "when": "view == ctxMan.sessions",
          "group": "navigation@3"
        },
        {
          "command": "ctxMan.continueOnAccount",
          "when": "view == ctxMan.sessions",
          "group": "1_session@1"
        },
        {
          "command": "ctxMan.exportHandoff",
          "when": "view == ctxMan.sessions",
          "group": "1_session@2"
        },
        {
          "command": "ctxMan.addAccount",
          "when": "view == ctxMan.sessions",
          "group": "2_accounts@1"
        },
        {
          "command": "ctxMan.showHiddenAccounts",
          "when": "view == ctxMan.sessions",
          "group": "2_accounts@2"
        },
        {
          "command": "ctxMan.configureStatusLine",
          "when": "view == ctxMan.sessions",
          "group": "3_statusline@1"
        },
        {
          "command": "ctxMan.setupAiFiles",
          "when": "view == ctxMan.sessions",
          "group": "4_setup@1"
        }
      ],
      "commandPalette": [
        {
          "command": "ctxMan.revealSession",
          "when": "false"
        },
        {
          "command": "ctxMan.copySessionId",
          "when": "false"
        },
        {
          "command": "ctxMan.activateAccount",
          "when": "false"
        },
        {
          "command": "ctxMan.hideAccount",
          "when": "false"
        },
        {
          "command": "ctxMan.showAllProjects",
          "when": "false"
        },
        {
          "command": "ctxMan.showWorkspaceOnly",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Claude Ctx Man",
      "properties": {
        "ctxMan.accounts": {
          "type": "array",
          "default": [],
          "description": "Extra Claude Code config folders (or labels for discovered ones).",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "description": "Short name shown in the UI"
              },
              "configDir": {
                "type": "string",
                "description": "Folder used as CLAUDE_CONFIG_DIR, e.g. ~/.claude-alt"
              }
            },
            "required": [
              "configDir"
            ]
          }
        },
        "ctxMan.hiddenAccounts": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Accounts to hide from the panel and pickers, by label (e.g. \"default\") or config folder path."
        },
        "ctxMan.autoDiscover": {
          "type": "boolean",
          "default": true,
          "description": "Find ~/.claude and ~/.claude-* folders automatically."
        },
        "ctxMan.claudeCommand": {
          "type": "string",
          "default": "claude",
          "description": "Command used to start Claude Code in the terminal."
        },
        "ctxMan.syncTerminalEnv": {
          "type": "boolean",
          "default": true,
          "description": "On switch, set CLAUDE_CONFIG_DIR for new integrated terminals (terminal.integrated.env.*)."
        },
        "ctxMan.syncClaudeExtension": {
          "type": "boolean",
          "default": true,
          "description": "On switch, set CLAUDE_CONFIG_DIR for the Claude Code extension (claudeCode.environmentVariables)."
        },
        "ctxMan.switchActiveOnContinue": {
          "type": "boolean",
          "default": true,
          "description": "After continuing a session on another account, make that account the active one."
        },
        "ctxMan.maxSessionsPerAccount": {
          "type": "number",
          "default": 30,
          "description": "How many recent sessions to list per account."
        },
        "ctxMan.handoffDir": {
          "type": "string",
          "default": ".ctx-man",
          "description": "Folder (relative to the workspace) where handoff files are written."
        },
        "ctxMan.handoffMessages": {
          "type": "number",
          "default": 12,
          "description": "How many recent messages to include in a handoff."
        }
      }
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@types/vscode": "^1.85.0",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
